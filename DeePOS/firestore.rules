rules_version = '2';

// Booth POS security rules.
// Paste this into: Firebase console > Firestore Database > Rules > Publish.
//
// Who is who: every person needs a document roles/{their user ID} with a field
//   role: "staff"   -> can use the cashier (and later kitchen / floor / board)
//   role: "admin"   -> staff + the whole admin dashboard (menu, stock, sales, closing, reports)
//   role: "owner"   -> same as admin (you)
// An account with no roles document can do NOTHING, even if it can sign in.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function role() {
      return get(roleDoc()).data.role;
    }
    function isStaff() {
      return signedIn() && exists(roleDoc()) && role() in ["staff", "admin", "owner"];
    }
    function isAdmin() {
      return signedIn() && exists(roleDoc()) && role() in ["admin", "owner"];
    }
    function isOwner() {
      return signedIn() && exists(roleDoc()) && role() == "owner";
    }

    // ---------- Roles: you can read your own, nobody can change them from the app ----------
    // (You add or edit roles yourself in the Firebase console.)
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Menu: staff read it, only admins change it ----------
    match /menu/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- Orders ----------
    match /orders/{orderId} {
      allow read: if isStaff();

      // New orders must have the right shape. Stops junk data and fake totals.
      allow create: if isStaff()
        && request.resource.data.keys().hasAll(["no", "day", "items", "total", "pay", "status", "createdAt"])
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.pay in ["cash", "qr", "free"]
        && request.resource.data.status in ["preparing", "collected"];

      // After an order is saved, staff may ONLY move it along or void it.
      // Nobody can change the items, total or payment of an existing order.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "readyAt", "collectedAt", "voidReason", "voidedAt", "voidedBy"])
        && request.resource.data.status in ["preparing", "ready", "collected", "void"];

      // Orders are never deleted (voids keep the record).
      allow delete: if false;
    }

    // ---------- Stock items ----------
    // Staff can read levels (the cashier bars need them) and change ONLY "onHand",
    // which is what a sale or a void does. Names, costs, warnings: admins only.
    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["onHand"])
            && request.resource.data.onHand is number);
    }

    // ---------- Purchases: admins only, and never edited or deleted (audit trail) ----------
    match /purchases/{purchaseId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- Opening / closing stock counts: admins only ----------
    match /stockCounts/{day} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Daily closings (cash, hours, booth fee): admins only ----------
    match /days/{day} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Settings (salary rate, share, booth fee, staff names): admins only ----------
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------- The books: owner only ----------
    match /owner/{rest=**} {
      allow read, write: if isOwner();
    }

    // Everything else (including the old "test" collection) is locked.
  }
}
